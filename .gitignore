# Runtime snapshot cache — plain JSON stays local; the gzipped snapshot and the
# delta beside it are committed (built daily by the refresh-data GitHub Action).
# changes.json has to ship with the snapshot: it records what the rebuild added
# and removed, and a removal cannot be recomputed from the snapshot afterwards.
cache/*
!cache/snapshot.json.gz
!cache/changes.json
# The field-level quality profile of the published build. Committed because the
# gate compares against what was actually published, not against a local run.
!cache/quality.json

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
*.swp

# Local tooling
.claude/

# Xcode — per-user state and build output; the project and sources are committed
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/build/
DerivedData/
